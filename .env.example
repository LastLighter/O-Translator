# ---------------------------------------------------------------------------
# O-Translator configuration. Copy to `.env` and edit. All OTR_* values are
# optional. DEEPSEEK_API_KEY intentionally uses the standard name too.
# ---------------------------------------------------------------------------

# --- DeepSeek translation ---------------------------------------------------
DEEPSEEK_API_KEY=
OTR_TRANSLATION_PROVIDER=auto
OTR_DEEPSEEK_MODEL=deepseek-chat
OTR_DEEPSEEK_BASE_URL=https://api.deepseek.com
OTR_TRANSLATION_TIMEOUT_S=60
OTR_TRANSLATION_BATCH_SIZE=40
OTR_TRANSLATION_CONCURRENCY=3
# Keep the OCR text if the API fails, instead of failing the whole job.
OTR_TRANSLATION_FALLBACK_TO_SOURCE=true

# --- OCR --------------------------------------------------------------------
# auto | paddle | onnx | tesseract | none
# `onnx` uses RapidOCR weights through the shared ORT provider policy.
OTR_OCR_ENGINE=auto
# auto | cpu | cuda | openvino | dml (DirectML)
OTR_OCR_DEVICE=auto
# Optional explicit ORT provider order for the ONNX OCR adapter, e.g.
# CUDAExecutionProvider,OpenVINOExecutionProvider,DmlExecutionProvider,CPUExecutionProvider
OTR_OCR_PROVIDERS=
# Default model used when source_lang is auto and the page is not manga.
# zh -> ch, ja -> japan, en -> en, ko -> korean.
OTR_PADDLE_LANG=ch
# auto | fast | quality
# auto: mobile models for CJK/Latin; server detector + mobile recognizer for
#       Japanese vertical columns. quality: server det + server rec (slower).
OTR_PADDLE_PROFILE=auto
# Retry with the Japanese model when auto-detection sees kana/vertical text.
OTR_PADDLE_AUTO_FALLBACK=true
# Leave empty for automatic model selection; explicit names override the profile.
OTR_PADDLE_DET_MODEL=
OTR_PADDLE_REC_MODEL=
OTR_PADDLE_DET_LIMIT_SIDE_LEN=1280
OTR_OCR_MIN_CONFIDENCE=0.50
# Comma-separated Tesseract languages, e.g. chi_sim+eng+jpn.
OTR_TESSERACT_LANG=chi_sim+eng

# --- Inpainting -------------------------------------------------------------
# auto | lama | opencv
OTR_INPAINT_ENGINE=auto
# The default expands to the best sibling: lama_fp32_sim.onnx (bundled),
# lama_fp32_fp16.onnx, lama_fp32_int8.onnx, or lama_fp32.onnx.
OTR_LAMA_MODEL_PATH=models/lama/lama_fp32.onnx
# auto: folded FP32 when available, then FP16/INT8 if no FP32 graph exists.
# fp32 | fp16 | int8 force a precision family (FP16/INT8 are opt-in; validate
# them on your hardware, LaMa's FFC/FFT blocks are precision-sensitive).
OTR_LAMA_PRECISION=auto
# auto | cpu | cuda | openvino | dml (DirectML)
OTR_LAMA_DEVICE=auto
# Optional explicit ORT provider order; empty uses the hardware device above.
OTR_LAMA_PROVIDERS=
# OpenVINO device_type: CPU, GPU, AUTO. DirectML device id defaults to 0.
OTR_LAMA_OPENVINO_DEVICE=CPU
OTR_LAMA_DML_DEVICE_ID=0
OTR_LAMA_NORMALIZATION=zero_one
# 0 = auto (capped at 4). The FFC/FFT graph stops scaling after a few threads.
OTR_LAMA_THREADS=0
# Only applies to dynamic-shape exports; the bundled Carve graph is fixed 512x512.
OTR_INPAINT_MAX_SIDE=1024
OTR_DILATE_PX=7
# Adaptive fast fill: regions whose surrounding background stddev is below
# this threshold skip LaMa entirely. 24 handles UI gradients/speech bubbles;
# lower it (e.g. 8-12) for more conservative quality on artwork.
OTR_INPAINT_FAST_STDDEV=24
# Below this stddev a plain median-colour fill replaces Telea.
OTR_INPAINT_SOLID_STDDEV=3
# ROI crop padding around each text mask before LaMa inference.
OTR_INPAINT_ROI_PADDING=16
# LaMa inference is ~constant-cost per 512x512 patch, so one union ROI is
# usually cheaper than N per-region patches. Raise for quality/independence.
OTR_INPAINT_MAX_ROI_PATCHES=1
# alpha | seamless (OpenCV Poisson blend; falls back to alpha on failure)
OTR_INPAINT_BLEND=alpha
# Emit the pass-1 preview while LaMa finishes; the desktop HUD swaps with a fade.
OTR_PROGRESSIVE_PREVIEW=true
# Optional self-contained CUDA ONNX Runtime add-on (gpu_runtime/ next to the
# exe is auto-detected). Point this at a custom location if needed.
OTR_GPU_RUNTIME_DIR=
# Force the bundled CPU ORT even when a CUDA add-on is present.
OTR_DISABLE_GPU=0
# Download the ~198 MB LaMa ONNX weights only when no local/bundled graph exists.
OTR_LAMA_AUTO_DOWNLOAD=true
# Optional one-time graph folding (needs onnxsim): cuts cold load from ~30 s to
# ~2 s. The inpainter prefers models/lama/lama_fp32_sim.onnx automatically.
#   python scripts/optimize_lama.py --verify
# The packaged Windows build bundles that folded graph; no download is needed.
# Optional explicit URL that overrides the built-in mirrors.
OTR_LAMA_DOWNLOAD_URL=

# --- Network / model downloads ---------------------------------------------
# Only needed when the system proxy is not set. Clash Verge/Meta commonly uses
# http://127.0.0.1:7897; classic Clash uses http://127.0.0.1:7890.
OTR_PROXY=
# Optional Hugging Face mirror, e.g. https://hf-mirror.com
OTR_HF_ENDPOINT=

# --- Server / queue ---------------------------------------------------------
OTR_HOST=127.0.0.1
OTR_PORT=8765
OTR_QUEUE_WORKERS=2
OTR_MAX_UPLOAD_MB=20
OTR_MAX_IMAGE_SIDE=2400
OTR_LOG_LEVEL=INFO

# --- Rendering --------------------------------------------------------------
# Optional explicit TTF/TTC path. Auto-detects Microsoft YaHei / SimHei /
# Noto Sans CJK if empty.
OTR_FONT_PATH=
OTR_RENDER_MIN_FONT=7

# --- Desktop client ---------------------------------------------------------
OTR_API_URL=http://127.0.0.1:8765
# F2 is the default single-key capture hotkey. Use e.g. ctrl+alt+t if F2 is
# reserved by a game or another tool.
OTR_HOTKEY=f2
# Start the FastAPI server automatically if it is not already running.
OTR_CLIENT_AUTOSTART_BACKEND=true